
      graph {
         graph [rankdir=LR];
         node [label="\N",
             shape=plaintext
         ];
         edge [color=gray50,
             minlen=2,
             style=dashed
         ];
      
         label="buylog data model"
         labelloc=t

"setting" [label=<<FONT FACE="Helvetica"><TABLE BORDER="0" CELLBORDER="1" CELLPADDING="4" CELLSPACING="0"><TR><TD><B><FONT POINT-SIZE="16">setting</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="key"><u><FONT>key</FONT></u> <FONT> [VARCHAR]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="value"><FONT>value</FONT> <FONT> [VARCHAR]</FONT> NOT NULL</TD></TR></TABLE></FONT>>];
"forex" [label=<<FONT FACE="Helvetica"><TABLE BORDER="0" CELLBORDER="1" CELLPADDING="4" CELLSPACING="0"><TR><TD><B><FONT POINT-SIZE="16">forex</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><u><FONT>id</FONT></u> <FONT> [INTEGER]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="base_per_unit"><FONT>base_per_unit</FONT> <FONT> [FLOAT]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="code"><FONT>code</FONT> <FONT> [VARCHAR(3)]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="date"><FONT>date</FONT> <FONT> [DATE]</FONT> NOT NULL</TD></TR></TABLE></FONT>>];
