"purchase_order" [label=<<FONT FACE="Helvetica"><TABLE BORDER="0" CELLBORDER="1" CELLPADDING="4" CELLSPACING="0"><TR><TD><B><FONT POINT-SIZE="16">purchase_order</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><u><FONT>id</FONT></u> <FONT> [INTEGER]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="actual_delivery"><FONT>actual_delivery</FONT> <FONT> [DATE]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT>created_at</FONT> <FONT> [DATETIME]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="currency"><FONT>currency</FONT> <FONT> [VARCHAR]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="expected_delivery"><FONT>expected_delivery</FONT> <FONT> [DATE]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="grand_total"><FONT>grand_total</FONT> <FONT> [FLOAT]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="grand_total_base"><FONT>grand_total_base</FONT> <FONT> [FLOAT]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="invoice_number"><FONT>invoice_number</FONT> <FONT> [VARCHAR]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="notes"><FONT>notes</FONT> <FONT> [VARCHAR]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="order_date"><FONT>order_date</FONT> <FONT> [DATE]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="po_number"><FONT>po_number</FONT> <FONT> [VARCHAR]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><FONT>product_id</FONT> <FONT> [INTEGER]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="quantity"><FONT>quantity</FONT> <FONT> [INTEGER]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="quote_id"><FONT>quote_id</FONT> <FONT> [INTEGER]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="shipping_cost"><FONT>shipping_cost</FONT> <FONT> [FLOAT]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="status"><FONT>status</FONT> <FONT> [VARCHAR]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="tax"><FONT>tax</FONT> <FONT> [FLOAT]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="total_amount"><FONT>total_amount</FONT> <FONT> [FLOAT]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="unit_price"><FONT>unit_price</FONT> <FONT> [FLOAT]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="vendor_id"><FONT>vendor_id</FONT> <FONT> [INTEGER]</FONT> NOT NULL</TD></TR></TABLE></FONT>>];
