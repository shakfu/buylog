"quote" [label=<<FONT FACE="Helvetica"><TABLE BORDER="0" CELLBORDER="1" CELLPADDING="4" CELLSPACING="0"><TR><TD><B><FONT POINT-SIZE="16">quote</FONT></B></TD></TR><TR><TD ALIGN="LEFT" PORT="id"><u><FONT>id</FONT></u> <FONT> [INTEGER]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at"><FONT>created_at</FONT> <FONT> [DATETIME]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="discount"><FONT>discount</FONT> <FONT> [FLOAT]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="original_currency"><FONT>original_currency</FONT> <FONT> [VARCHAR]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="original_value"><FONT>original_value</FONT> <FONT> [FLOAT]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="product_id"><FONT>product_id</FONT> <FONT> [INTEGER]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="receipt_path"><FONT>receipt_path</FONT> <FONT> [VARCHAR]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="shipping_cost"><FONT>shipping_cost</FONT> <FONT> [FLOAT]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_url"><FONT>source_url</FONT> <FONT> [VARCHAR]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tax_rate"><FONT>tax_rate</FONT> <FONT> [FLOAT]</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="value"><FONT>value</FONT> <FONT> [FLOAT]</FONT> NOT NULL</TD></TR><TR><TD ALIGN="LEFT" PORT="vendor_id"><FONT>vendor_id</FONT> <FONT> [INTEGER]</FONT> NOT NULL</TD></TR></TABLE></FONT>>];
